{
  "name": "fleeet-agent-kit",
  "version": "1.0.0",
  "description": "fleeet.space reporting kit for coding agents: skill, MCP server, zero-dependency CLI",
  "type": "module",
  "scripts": {
    "pack-skill": "rm -rf dist && mkdir -p dist && python3 -m zipfile -c dist/fleeet-skill.zip skills/fleeet-reporting",
    "check": "node --check bin/fleeet-emit.mjs && node -e \"for (const f of ['package.json','.claude-plugin/plugin.json','.claude-plugin/marketplace.json','schema/event-schema.json']) JSON.parse(require('fs').readFileSync(f,'utf8'))\""
  },
  "keywords": [
    "fleeet",
    "agent",
    "monitoring",
    "status",
    "reporting"
  ],
  "author": "Ronan Flynn-Curran",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nan-labs/fleeet-agent-kit-public.git"
  },
  "homepage": "https://github.com/nan-labs/fleeet-agent-kit-public",
  "bin": {
    "fleeet-emit": "bin/fleeet-emit.mjs"
  },
  "bugs": {
    "url": "https://github.com/nan-labs/fleeet-agent-kit-public/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
