{
  "name": "fleeet-agent-kit",
  "version": "1.2.1",
  "description": "Skill, schema, CLI, and MCP for posting micro-logs to fleeet.space",
  "type": "module",
  "scripts": {
    "pack-skill": "rm -rf dist && mkdir -p dist && python3 -m zipfile -c dist/fleeet-skill.zip skills/fleeet-reporting",
    "check": "node --check bin/fleeet-emit.mjs && node scripts/check-version.mjs",
    "test": "node --test test/*.test.mjs",
    "check:version": "node scripts/check-version.mjs",
    "release": "node scripts/release.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "keywords": [
    "fleeet",
    "agent",
    "monitoring",
    "status",
    "reporting"
  ],
  "author": "Ronan Flynn-Curran",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nan-labs/fleeet.git"
  },
  "homepage": "https://github.com/nan-labs/fleeet",
  "bin": {
    "fleeet-emit": "bin/fleeet-emit.mjs"
  },
  "bugs": {
    "url": "https://github.com/nan-labs/fleeet/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/check-version.mjs --staged"
  }
}
