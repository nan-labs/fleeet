---
// Starlight's footer plus one row of the canonical Fleeet links
// (same set as the app ⋮ menu and the kit README).
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>
<nav class="fleeet-links" aria-label="Fleeet links">
  <a href="https://fleeet.space">fleeet.space</a>
  <a href="https://docs.fleeet.space">Docs</a>
  <a href="https://github.com/nan-labs/fleeet">GitHub</a>
  <a href="https://github.com/nan-labs/fleeet/milestones?state=all">Roadmap</a>
  <a href="https://fleeet.space/llms.txt">llms.txt</a>
</nav>

<style>
.fleeet-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.25rem 1.25rem;
  margin-top: 2rem;
  padding-top: 1rem;
  border-top: 1px solid var(--line);
  font-size: var(--sl-text-sm);
}
.fleeet-links a {
  color: var(--ink-2);
  text-decoration: none;
}
.fleeet-links a:hover {
  color: var(--ink);
  text-decoration: underline;
}
</style>
