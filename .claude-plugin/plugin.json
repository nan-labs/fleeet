{
  "name": "fleeet-reporting",
  "version": "1.2.2",
  "description": "Report agent work status (start/heartbeat/blocked/end) to fleeet.space for user-initiated tasks",
  "author": { "name": "Ronan Flynn-Curran" },
  "homepage": "https://github.com/nan-labs/fleeet",
  "repository": "https://github.com/nan-labs/fleeet",
  "license": "MIT",
  "keywords": ["fleeet", "agent", "monitoring", "status", "reporting"],
  "mcpServers": {
    "fleeet": {
      "type": "http",
      "url": "${FLEEET_ENDPOINT:-https://fleeet.space}/mcp",
      "headers": { "Authorization": "Bearer ${FLEEET_TOKEN}" }
    }
  }
}
