{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleeet.space/schema/event.json",
  "title": "fleeet agent check-in event",
  "description": "A single status event posted by an agent to fleeet. Four types: session_start, heartbeat, blocked, session_end.",
  "type": "object",
  "required": ["event", "run_id", "ts", "agent", "summary"],
  "properties": {
    "event": {
      "type": "string",
      "enum": ["session_start", "heartbeat", "blocked", "session_end"],
      "description": "The kind of check-in."
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable UUID generated at session_start, reused for every event in this run."
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp with timezone."
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Human-readable name of the agent. e.g. 'claude-sonnet-4', 'ronan-dev-agent'."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "description": "One sentence, present tense, no period. Slack-thread voice."
    },
    "trigger": {
      "type": "string",
      "enum": ["user", "routine", "agent"],
      "default": "user",
      "description": "What initiated this work. 'user' = human prompt/task, 'routine' = cron/scheduled, 'agent' = autonomous agent decision. Default: user."
    },
    "task": {
      "type": "string",
      "description": "What the agent is working on. Required on session_start; optional elsewhere (fleeet remembers from session_start)."
    },
    "source": {
      "type": "object",
      "description": "Where to look for exhaust that corresponds to this run. Fleeet uses this to reconcile self-reports against reality.",
      "properties": {
        "repo": { "type": "string", "description": "e.g. 'ronan/fleeet'" },
        "branch": { "type": "string" },
        "linear_issue": { "type": "string", "description": "e.g. 'ENG-1204'" },
        "cowork_session_id": { "type": "string" },
        "vercel_project": { "type": "string" }
      },
      "additionalProperties": true
    },
    "progress": {
      "type": "object",
      "description": "Only meaningful on heartbeat.",
      "properties": {
        "commits": { "type": "integer", "minimum": 0 },
        "files_changed": { "type": "integer", "minimum": 0 },
        "tests_passing": { "type": "integer", "minimum": 0 },
        "tests_failing": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "blocker": {
      "type": "object",
      "description": "Required on blocked events.",
      "required": ["kind", "question"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["ambiguity", "missing_credential", "failing_dep", "design_call", "access", "other"]
        },
        "question": {
          "type": "string",
          "maxLength": 480,
          "description": "The specific thing the human needs to resolve."
        },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "description": "If the agent has plausible answers, list them. Two or three max."
        }
      }
    },
    "outcome": {
      "type": "object",
      "description": "Only on session_end.",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["shipped", "abandoned", "handed_off", "failed"]
        },
        "artefacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "url"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["pr", "commit", "deploy", "doc", "design", "other"]
              },
              "url": { "type": "string", "format": "uri" },
              "label": { "type": "string" }
            }
          }
        },
        "note": {
          "type": "string",
          "maxLength": 480
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event": { "const": "session_start" } } },
      "then": { "required": ["task"] }
    },
    {
      "if": { "properties": { "event": { "const": "blocked" } } },
      "then": { "required": ["blocker"] }
    },
    {
      "if": { "properties": { "event": { "const": "session_end" } } },
      "then": { "required": ["outcome"] }
    }
  ]
}
